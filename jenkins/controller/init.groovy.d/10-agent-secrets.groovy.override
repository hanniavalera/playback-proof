import hudson.slaves.SlaveComputer
import java.nio.file.Files
import java.nio.file.Paths
import java.nio.file.attribute.PosixFilePermissions
import jenkins.model.Jenkins

// Hands every inbound agent its connection secret through the volume the agent container shares with this controller
// (ADR-117). The secret is derived from the controller's own key and the agent's name, so it is the same after a restart.
// It is written with mode 0600 and is never printed or logged. This runs after Configuration as Code has created the nodes.
def directory = Paths.get(System.getenv('AGENT_SECRET_DIR') ?: '/run/agent-secrets')
def names = []
Jenkins.get().nodes.each { node ->
    def computer = node.toComputer()
    if (computer instanceof SlaveComputer) {
        def file = directory.resolve(node.nodeName)
        Files.deleteIfExists(file)
        Files.createFile(file, PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString('rw-------')))
        Files.write(file, computer.jnlpMac.getBytes('UTF-8'))
        names << node.nodeName
    }
}
if (names.isEmpty()) {
    println "agent-secrets: no inbound agent is defined, nothing was written to ${directory}"
} else {
    println "agent-secrets: wrote the connection secret of ${names} to ${directory}"
}
