    "text": "{\n  \"schemaVersion\": 1,\n  \"id\": \"pipeline-check\",\n  \"kind\": \"pipeline-check\",\n  \"catalogId\": null,\n  \"title\": \"Pipeline check: six sessions that prove the harness runs end to end (it decides nothing)\",\n  \"registeredOn\": \"2026-11-04\",\n  \"hypotheses\": [\n    {\n      \"metric\": \"startupMs\",\n      \"text\": \"None about the configurations: this run proves that the service, the browser, the page, the runner, the analysis and the report work together. Six sessions cannot say anything about configuration B.\"\n    }\n  ],\n  \"engine\": \"chromium\",\n  \"stream\": \"vod-cmaf\",\n  \"protocol\": \"dash\",\n  \"arms\": { \"A\": \"A\", \"B\": \"B\" },\n  \"conditions\": [\n    {\n      \"id\": \"high-latency\",\n      \"profile\": \"high-latency\",\n      \"rules\": [{ \"type\": \"latency\", \"ms\": 300, \"jitterMs\": 100, \"match\": { \"kind\": \"any\" } }],\n      \"rationale\": \"The catalog condition of the startup experiment: 300 ms before the first byte of every response makes every download measurable by the player's estimator, for the whole session.\"\n    }\n  ],\n  \"observation\": { \"mediaSecondsAfterFirstFrame\": 6, \"sessionTimeoutMs\": 60000 },\n  \"sessionsPerArm\": 2,\n  \"warmupSessionsPerArm\": 1,\n  \"alpha\": 0.05,\n  \"bootstrapResamples\": 1000,\n  \"metrics\": [\n    {\n      \"id\": \"startupMs\",\n      \"role\": \"primary\",\n      \"direction\": \"lower-is-better\",\n      \"practicalThreshold\": 100,\n      \"thresholdBasis\": \"A tenth of a second is the smallest startup change a viewer notices on a page load. A pipeline check decides nothing, so the number only has to be there.\"\n    },\n    { \"id\": \"rebufferShare\", \"role\": \"secondary\", \"direction\": \"lower-is-better\" },\n    { \"id\": \"rebufferRatio\", \"role\": \"secondary\", \"direction\": \"lower-is-better\" }\n  ],\n  \"decisionRule\": {\n    \"id\": \"pb-ab-v1\",\n    \"text\": \"Four verdicts and no more: B better (ship B), A better (do not ship B), equivalent within the margin (keep A), inconclusive (keep A and collect more sessions). A pipeline check applies none of them: it prints no verdict.\"\n  },\n  \"exclusionRule\": {\n    \"text\": \"A session that errors or times out is a failed session: it is reported and never silently dropped; its metrics are left out of the comparison.\",\n    \"maxFailedShare\": 0.1,\n    \"abortAfterConsecutiveFailures\": 5\n  },\n  \"seed\": 20261104\n}\n",
